                "operationId": "profitAndLoss",
                "summary": "Profit and loss for a date range",
                "tags": [
                    "Ledger"
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Tenant"
                    },
                    {
                        "name": "from",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "YYYY-MM-DD"
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "YYYY-MM-DD"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfitAndLoss"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refused",
