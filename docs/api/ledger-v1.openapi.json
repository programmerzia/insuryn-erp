{
    "openapi": "3.1.0",
    "info": {
        "title": "Insuryn Ledger API",
        "version": "1.0.0",
        "description": "External accounting event ingest and read-only ledger queries. Integration users (kind=integration) obtain Bearer tokens from POST /api/v1/tokens. Amounts are in minor units."
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "paths": {
        "/api/v1/balances": {
            "get": {
                "operationId": "show",
                "summary": "Account balance as of a date",
                "tags": [
                    "Ledger"
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Tenant"
                    },
                    {
                        "name": "as_of",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "YYYY-MM-DD"
                    },
                    {
                        "name": "account",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Account code (required)"
                    },
                    {
                        "name": "dimension",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Optional dimension name"
                    },
                    {
                        "name": "value",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Dimension value when dimension is set"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AccountBalance"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refused",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Refused",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ]
            }
        },
