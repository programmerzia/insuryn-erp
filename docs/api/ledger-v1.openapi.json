                "parameters": [
                    {
                        "$ref": "#/components/parameters/Tenant"
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Done"
                    },
                    "401": {
                        "description": "Refused",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
