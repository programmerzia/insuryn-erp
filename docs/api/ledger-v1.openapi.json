        "/api/v1/tokens": {
            "post": {
                "operationId": "issue",
                "summary": "Issue a Bearer token for an integration user",
                "tags": [
                    "Ledger"
                ],
                "parameters": [
                    {
                        "$ref": "#/components/parameters/Tenant"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "OK",
                        "content": {
                            "application/json": {
