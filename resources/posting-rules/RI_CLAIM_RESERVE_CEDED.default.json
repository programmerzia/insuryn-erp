{
  "code": "RI_CLAIM_RESERVE_CEDED.default",
  "version": 1,
  "event_type": "RI_CLAIM_RESERVE_CEDED",
  "_comment": "Reinsurance MVP (G4): the reinsurer's share of a claim reserve change, following the cession of the policy; claims incurred are shown net of it. A negative share (a reserve decrease or release) flips both lines.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","claim","reinsurer"], "inherit_from_event": true },
  "lines": [
    { "role": "ri_outstanding_claims", "side": "debit",  "amount": "payload.amount" },
    { "role": "claims_expense",        "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "RI_CLAIM_RESERVE_CEDED:{share_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
