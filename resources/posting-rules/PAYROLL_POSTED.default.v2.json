{
  "code": "PAYROLL_POSTED.default",
  "version": 2,
  "event_type": "PAYROLL_POSTED",
  "_comment": "Phase 2 People/Payroll MVP (addendum §B.10.4, DECISION D-124): one event per branch and department of a payroll run (the kernel has no for_each lines yet). Salary (basic and allowances) and festival bonus expense; commission paid through payroll (pre_accrued) is not expensed again, its liability is already in salary_payable (COMMISSION_PAYOUT_TO_PAYROLL). An event without salary, bonus or pre_accrued posts exactly as version 1 (gross; zero lines dropped).",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch"], "inherit_from_event": true },
  "lines": [
    { "role": "salary_expense",       "side": "debit",  "amount": "payload.salary ?? payload.gross" },
    { "role": "bonus_expense",        "side": "debit",  "amount": "payload.bonus ?? 0" },
    { "role": "employer_pf_expense",  "side": "debit",  "amount": "payload.employer_pf" },
    { "role": "salary_payable",       "side": "credit", "amount": "sub(payload.net, payload.pre_accrued ?? 0)" },
    { "role": "employee_tax_payable", "side": "credit", "amount": "payload.employee_tax" },
    { "role": "pf_payable",           "side": "credit", "amount": "add(payload.employee_pf, payload.employer_pf)" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PAYROLL_POSTED:{payroll_run_id}:{branch}:{department}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
