{
  "code": "PREMIUM_RECEIVED.default",
  "version": 2,
  "event_type": "PREMIUM_RECEIVED",
  "_comment": "Gap fix GA-14 (D-86): a cheque taken into clearing (payload.in_clearing = 1) is debited to cheques_in_clearing until CHEQUE_CLEARED moves it to the bank. An event without payload.in_clearing posts exactly as version 1 (the zero line is dropped before its role is looked up); version 1 stays on record.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","policy","customer"], "inherit_from_event": true },
  "lines": [
    { "role": "bank_main",           "side": "debit",  "amount": "(payload.in_clearing ?? 0) > 0 ? 0 : payload.amount" },
    { "role": "cheques_in_clearing", "side": "debit",  "amount": "(payload.in_clearing ?? 0) > 0 ? payload.amount : 0" },
    { "role": "premium_receivable",  "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PREMIUM_RECEIVED:{receipt_allocation_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
