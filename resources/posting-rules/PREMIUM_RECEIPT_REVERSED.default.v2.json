{
  "code": "PREMIUM_RECEIPT_REVERSED.default",
  "version": 2,
  "event_type": "PREMIUM_RECEIPT_REVERSED",
  "_comment": "Gap fix GA-14 (D-86): a cheque that bounces before it cleared (payload.in_clearing = 1) leaves cheques_in_clearing, not the bank. Without payload.in_clearing it posts exactly as version 1.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","policy","customer"], "inherit_from_event": true },
  "lines": [
    { "role": "premium_receivable",  "side": "debit",  "amount": "payload.amount" },
    { "role": "bank_main",           "side": "credit", "amount": "(payload.in_clearing ?? 0) > 0 ? 0 : payload.amount" },
    { "role": "cheques_in_clearing", "side": "credit", "amount": "(payload.in_clearing ?? 0) > 0 ? payload.amount : 0" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PREMIUM_RECEIPT_REVERSED:{receipt_allocation_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
