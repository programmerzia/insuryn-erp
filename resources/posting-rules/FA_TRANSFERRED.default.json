{
  "code": "FA_TRANSFERRED.default",
  "version": 1,
  "event_type": "FA_TRANSFERRED",
  "_comment": "Design addendum v2 §B.7 ASSET_TRANSFERRED: cost and accumulated depreciation move from one branch to another — net zero per account, no profit or loss.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","asset"], "inherit_from_event": true },
  "lines": [
    { "role": "fixed_asset_cost",         "side": "debit",  "amount": "payload.cost",        "dims": { "branch": "payload.to_branch" } },
    { "role": "fixed_asset_cost",         "side": "credit", "amount": "payload.cost",        "dims": { "branch": "payload.from_branch" } },
    { "role": "accumulated_depreciation", "side": "debit",  "amount": "payload.accumulated", "dims": { "branch": "payload.from_branch" } },
    { "role": "accumulated_depreciation", "side": "credit", "amount": "payload.accumulated", "dims": { "branch": "payload.to_branch" } }
  ],
  "validation": ["cost > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "FA_TRANSFERRED:{asset_movement_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
