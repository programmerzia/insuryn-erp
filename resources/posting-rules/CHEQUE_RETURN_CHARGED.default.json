{
  "code": "CHEQUE_RETURN_CHARGED.default",
  "version": 1,
  "event_type": "CHEQUE_RETURN_CHARGED",
  "_comment": "Gap fix GA-14 (D-87): the charge the bank deducted for a returned cheque, recorded with the bounce: an expense paid out of the receipt's bank account.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch"], "inherit_from_event": true },
  "lines": [
    { "role": "bank_charges", "side": "debit",  "amount": "payload.amount" },
    { "role": "bank_main",    "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "CHEQUE_RETURN_CHARGED:{receipt_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
