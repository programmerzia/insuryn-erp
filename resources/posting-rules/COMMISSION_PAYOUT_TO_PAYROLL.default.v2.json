{
  "code": "COMMISSION_PAYOUT_TO_PAYROLL.default",
  "version": 2,
  "event_type": "COMMISSION_PAYOUT_TO_PAYROLL",
  "_comment": "Addendum §B.10.7: version 2 puts the employee on the salary_payable line (payload.employee_id, from producers.employee_id), so the payroll reconciliation lists the liability per employee. An event without employee_id posts as version 1.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch", "agent"], "inherit_from_event": true },
  "lines": [
    { "role": "commission_payable", "side": "debit",  "amount": "payload.amount" },
    { "role": "salary_payable",     "side": "credit", "amount": "payload.amount", "dims": { "employee": "payload.employee_id" } }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "COMMISSION_PAYOUT_TO_PAYROLL:{commission_statement_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
