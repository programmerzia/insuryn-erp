{
  "code": "PETTY_CASH_REPLENISHED.default",
  "version": 1,
  "event_type": "PETTY_CASH_REPLENISHED",
  "_comment": "Design addendum v2 §B.6: the approved top-up of the vouchers spent (imprest) — DR the float's petty cash account / CR the bank account.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","petty_cash_float"], "inherit_from_event": true },
  "lines": [
    { "role": "petty_cash", "side": "debit",  "amount": "payload.amount" },
    { "role": "bank_main", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PETTY_CASH_REPLENISHED:{petty_cash_replenishment_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
