{
  "code": "POLICY_ENDORSED.default",
  "version": 1,
  "event_type": "POLICY_ENDORSED",
  "_comment": "Design §5.4 'endorse (delta)': the premium change of an endorsement posted like POLICY_ISSUED; a negative delta flips each line.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","customer"], "inherit_from_event": true },
  "lines": [
    { "role": "premium_receivable",  "side": "debit",  "amount": "payload.gross_premium_delta" },
    { "role": "unearned_premium",    "side": "credit", "amount": "payload.net_premium_delta" },
    { "role": "premium_tax_payable", "side": "credit", "amount": "payload.tax_delta" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "POLICY_ENDORSED:{policy_transaction_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
