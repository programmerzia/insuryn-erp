{
  "code": "CLAIM_RESERVE_ADJUSTED.default",
  "version": 1,
  "event_type": "CLAIM_RESERVE_ADJUSTED",
  "_comment": "D-04 / design §4.6: same lines as CLAIM_RESERVED for the reserve delta; a negative delta flips both sides (the engine does this).",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","claim"], "inherit_from_event": true },
  "lines": [
    { "role": "claims_expense",     "side": "debit",  "amount": "payload.delta" },
    { "role": "claims_outstanding", "side": "credit", "amount": "payload.delta" }
  ],
  "validation": ["delta != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "CLAIM_RESERVE_ADJUSTED:{claim_id}:{reserve_version}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
