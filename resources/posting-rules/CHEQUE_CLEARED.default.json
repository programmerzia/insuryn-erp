{
  "code": "CHEQUE_CLEARED.default",
  "version": 1,
  "event_type": "CHEQUE_CLEARED",
  "_comment": "Gap fix GA-14 (D-86): the bank credited a cheque that waited in clearing; the whole cheque moves to the receipt's bank account (bank_main is overridable).",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch"], "inherit_from_event": true },
  "lines": [
    { "role": "bank_main",           "side": "debit",  "amount": "payload.amount" },
    { "role": "cheques_in_clearing", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "CHEQUE_CLEARED:{receipt_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
