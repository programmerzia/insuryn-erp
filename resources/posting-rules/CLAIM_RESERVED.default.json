{
  "code": "CLAIM_RESERVED.default",
  "version": 1,
  "event_type": "CLAIM_RESERVED",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","claim"], "inherit_from_event": true },
  "lines": [
    { "role": "claims_expense",     "side": "debit",  "amount": "payload.amount" },
    { "role": "claims_outstanding", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "CLAIM_RESERVED:{claim_id}:{reserve_version}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
