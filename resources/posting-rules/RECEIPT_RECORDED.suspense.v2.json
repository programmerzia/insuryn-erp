{
  "code": "RECEIPT_RECORDED.suspense",
  "version": 2,
  "event_type": "RECEIPT_RECORDED",
  "_comment": "Gap fix GA-14 (D-86): the unallocated part of a cheque taken into clearing (payload.in_clearing = 1) is debited to cheques_in_clearing. Without payload.in_clearing it posts exactly as version 1.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch"], "inherit_from_event": true },
  "lines": [
    { "role": "bank_main",           "side": "debit",  "amount": "(payload.in_clearing ?? 0) > 0 ? 0 : payload.amount" },
    { "role": "cheques_in_clearing", "side": "debit",  "amount": "(payload.in_clearing ?? 0) > 0 ? payload.amount : 0" },
    { "role": "suspense_receipts",   "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "RECEIPT_RECORDED:{receipt_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
