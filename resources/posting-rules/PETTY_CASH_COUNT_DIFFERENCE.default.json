{
  "code": "PETTY_CASH_COUNT_DIFFERENCE.default",
  "version": 1,
  "event_type": "PETTY_CASH_COUNT_DIFFERENCE",
  "_comment": "Design addendum v2 §B.6: a cash count that differs from the book — a shortage DR petty cash over/short / CR petty cash; a surplus (negative shortage) the other way.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","petty_cash_float"], "inherit_from_event": true },
  "lines": [
    { "role": "petty_cash_over_short", "side": "debit",  "amount": "payload.shortage" },
    { "role": "petty_cash", "side": "credit", "amount": "payload.shortage" }
  ],
  "validation": ["shortage != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PETTY_CASH_COUNT_DIFFERENCE:{petty_cash_count_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
