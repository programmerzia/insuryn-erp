{
  "code": "FA_ACQUIRED.default",
  "version": 1,
  "event_type": "FA_ACQUIRED",
  "_comment": "Design addendum v2 §B.7 (ASSET_CAPITALISED, manual capitalisation): DR the class cost account (account_overrides.fixed_asset_cost) / CR the bank account paid from, or accounts payable when bought on credit.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","asset"], "inherit_from_event": true },
  "lines": [
    { "role": "fixed_asset_cost", "side": "debit",  "amount": "payload.cost" },
    { "role": "bank_main",        "side": "credit", "amount": "payload.paid_by_bank" },
    { "role": "accounts_payable", "side": "credit", "amount": "payload.on_credit" }
  ],
  "validation": ["cost > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "FA_ACQUIRED:{fixed_asset_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
