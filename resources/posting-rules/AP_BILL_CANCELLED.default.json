{
  "code": "AP_BILL_CANCELLED.default",
  "version": 1,
  "event_type": "AP_BILL_CANCELLED",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch", "payee_party", "ap_bill"], "inherit_from_event": true },
  "lines": [
    { "for_each": "payload.lines", "lines": [
      { "role": "ap_expense", "account": "item.account_id", "side": "credit", "amount": "item.expense", "dims": { "claim": "item.claim_id", "policy": "item.policy_id" }, "memo": "Supplier bill line cancelled" },
      { "role": "input_vat_receivable", "side": "credit", "amount": "item.recoverable_vat" }
    ] },
    { "role": "accounts_payable", "side": "debit", "amount": "payload.payable" },
    { "role": "vat_deducted_at_source_payable", "side": "debit", "amount": "payload.vds" },
    { "role": "supplier_tax_withheld_payable", "side": "debit", "amount": "payload.tds" }
  ],
  "validation": ["period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "AP_BILL_CANCELLED:{ap_bill_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
