{
  "code": "POLICY_CANCELLED.default",
  "version": 1,
  "event_type": "POLICY_CANCELLED",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","customer"], "inherit_from_event": true },
  "lines": [
    { "role": "unearned_premium",         "side": "debit",  "amount": "payload.unearned_remaining" },
    { "role": "premium_tax_payable",      "side": "debit",  "amount": "payload.tax_reversal" },
    { "role": "premium_receivable",       "side": "credit", "amount": "payload.receivable_outstanding" },
    { "role": "customer_refund_payable",  "side": "credit", "amount": "payload.refund_due" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "POLICY_CANCELLED:{policy_transaction_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
