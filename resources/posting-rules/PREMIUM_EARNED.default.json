{
  "code": "PREMIUM_EARNED.default",
  "version": 1,
  "event_type": "PREMIUM_EARNED",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy"], "inherit_from_event": true },
  "lines": [
    { "role": "unearned_premium", "side": "debit",  "amount": "payload.earned" },
    { "role": "premium_income",   "side": "credit", "amount": "payload.earned" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PREMIUM_EARNED:{policy_id}:{period_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
