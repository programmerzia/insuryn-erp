{
  "code": "IBNR_PROVISION_REVERSED.default",
  "version": 1,
  "event_type": "IBNR_PROVISION_REVERSED",
  "_comment": "Market gap G5: the prior quarter's IBNR provision per class released when the next quarter's run is posted.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","lob"], "inherit_from_event": true },
  "lines": [
    { "role": "ibnr_provision",      "side": "debit",  "amount": "payload.amount" },
    { "role": "claims_ibnr_expense", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "IBNR_PROVISION_REVERSED:{run_id}:{class}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
