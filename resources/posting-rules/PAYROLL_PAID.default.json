{
  "code": "PAYROLL_PAID.default",
  "version": 1,
  "event_type": "PAYROLL_PAID",
  "_comment": "Phase 2 People/Payroll MVP (addendum §B.10.4): the salary bank transfer of a posted run. DR salary_payable for the run's net pay (commission paid through payroll included), CR the paying bank account (bank_main, overridden per bank account).",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch"], "inherit_from_event": true },
  "lines": [
    { "role": "salary_payable", "side": "debit",  "amount": "payload.amount" },
    { "role": "bank_main",      "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PAYROLL_PAID:{payroll_run_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
