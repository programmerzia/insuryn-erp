{
  "code": "RI_UPR_ADJUSTED.default",
  "version": 1,
  "event_type": "RI_UPR_ADJUSTED",
  "_comment": "Reinsurance MVP (G4): the change in the reinsurers' share of unearned premium at a period end, per branch and reinsurer; a decrease flips both lines.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","reinsurer"], "inherit_from_event": true },
  "lines": [
    { "role": "ri_unearned_premium", "side": "debit",  "amount": "payload.delta" },
    { "role": "ri_premium_ceded",    "side": "credit", "amount": "payload.delta" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "RI_UPR_ADJUSTED:{adjustment_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
