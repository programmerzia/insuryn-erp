{
  "code": "COMMISSION_CLAWBACK.default",
  "version": 1,
  "event_type": "COMMISSION_CLAWBACK",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","agent"], "inherit_from_event": true },
  "lines": [
    { "role": "commission_payable",             "side": "debit",  "amount": "sub(payload.amount, payload.withholding)" },
    { "role": "commission_withholding_payable", "side": "debit",  "amount": "payload.withholding" },
    { "role": "commission_expense",             "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "COMMISSION_CLAWBACK:{commission_entry_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
