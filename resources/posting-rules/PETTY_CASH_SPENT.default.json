{
  "code": "PETTY_CASH_SPENT.default",
  "version": 1,
  "event_type": "PETTY_CASH_SPENT",
  "_comment": "Design addendum v2 §B.6 (PETTY_CASH_VOUCHER_POSTED): a voucher paid from the float — DR the voucher's expense account / CR the float's petty cash account.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","petty_cash_float"], "inherit_from_event": true },
  "lines": [
    { "role": "petty_cash_expense", "side": "debit",  "amount": "payload.amount" },
    { "role": "petty_cash", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "PETTY_CASH_SPENT:{petty_cash_voucher_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
