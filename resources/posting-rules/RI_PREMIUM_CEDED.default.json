{
  "code": "RI_PREMIUM_CEDED.default",
  "version": 1,
  "event_type": "RI_PREMIUM_CEDED",
  "_comment": "Reinsurance MVP (G4): premium ceded to one reinsurer (a cession row) and the reinsurer's commission on it, netted in the amount due to the reinsurer. A negative cession (a decrease or a cancellation) flips each line.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","reinsurer"], "inherit_from_event": true },
  "lines": [
    { "role": "ri_premium_ceded",     "side": "debit",  "amount": "payload.premium" },
    { "role": "ri_payable",           "side": "credit", "amount": "payload.premium" },
    { "role": "ri_payable",           "side": "debit",  "amount": "payload.commission" },
    { "role": "ri_commission_income", "side": "credit", "amount": "payload.commission" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "RI_PREMIUM_CEDED:{cession_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
