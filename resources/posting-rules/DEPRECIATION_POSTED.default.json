{
  "code": "DEPRECIATION_POSTED.default",
  "version": 1,
  "event_type": "DEPRECIATION_POSTED",
  "_comment": "Design addendum v2 §B.7: one month's depreciation of one asset, to the class's depreciation expense and accumulated depreciation accounts (account_overrides).",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","asset"], "inherit_from_event": true },
  "lines": [
    { "role": "depreciation_expense",     "side": "debit",  "amount": "payload.amount" },
    { "role": "accumulated_depreciation", "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "DEPRECIATION_POSTED:{fixed_asset_id}:{period_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
