{
  "code": "RI_CLAIM_RECOVERABLE.default",
  "version": 1,
  "event_type": "RI_CLAIM_RECOVERABLE",
  "_comment": "Reinsurance MVP (G4, DECISION D-106): the reinsurer's share of a claim payment becomes recoverable. The part already recognised as the reinsurer's share of the reserve moves out of that asset; the rest (a claim reserved before the policy was ceded) reduces claims incurred.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","product","policy","claim","reinsurer"], "inherit_from_event": true },
  "lines": [
    { "role": "ri_claims_recoverable", "side": "debit",  "amount": "payload.amount" },
    { "role": "ri_outstanding_claims", "side": "credit", "amount": "payload.from_reserve" },
    { "role": "claims_expense",        "side": "credit", "amount": "payload.direct" }
  ],
  "validation": ["amount != 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "RI_CLAIM_RECOVERABLE:{share_id}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
