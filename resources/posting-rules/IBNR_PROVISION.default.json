{
  "code": "IBNR_PROVISION.default",
  "version": 1,
  "event_type": "IBNR_PROVISION",
  "_comment": "Market gap G5: the quarterly technical provisions run sets the IBNR provision per class at the quarter end; the prior quarter's provision is released by IBNR_PROVISION_REVERSED on the same day.",
  "applies_to": { "product_codes": ["*"], "lob": ["*"], "channels": ["*"] },
  "effective_from": "2026-01-01",
  "effective_to": null,
  "books": ["LOCAL"],
  "dimensions": { "required": ["branch","lob"], "inherit_from_event": true },
  "lines": [
    { "role": "claims_ibnr_expense", "side": "debit",  "amount": "payload.amount" },
    { "role": "ibnr_provision",      "side": "credit", "amount": "payload.amount" }
  ],
  "validation": ["amount > 0", "period.open"],
  "reversal": { "strategy": "mirror", "allowed_until": "period_locked" },
  "idempotency": { "key": "IBNR_PROVISION:{run_id}:{class}" },
  "rounding": { "mode": "half_even", "residual_role": "rounding_difference" }
}
