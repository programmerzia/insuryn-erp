{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "brick/money": "^0.15.0",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/fortify": "^1.39",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.49",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "symfony/expression-language": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --database=pgsql_migrations --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "db:migrate": "@php artisan migrate --database=pgsql_migrations",
        "db:fresh": [
            "@php artisan migrate:fresh --database=pgsql_migrations --seed",
            "@php artisan db:seed --database=pgsql_migrations --class=DemoBusinessSeeder",
            "@php artisan db:seed --database=pgsql_migrations --class=DistributionDemoSeeder"
        ],
        "worker": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --kill-others -n worker,scheduler \"php artisan queue:work --queue=posting,batch,recon,default\" \"php artisan schedule:work\""
        ],
        "scheduler": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan schedule:work"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"@unlink('bootstrap/cache/config.php');\" --",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.25"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
